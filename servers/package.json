{
  "name": "@nolen/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-Powered Short Film Production Assistant — Backend Server & Worker",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "node dist/worker/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "health:check": "tsx src/scripts/health-check.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.6",
    "zod": "^3.24.4",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.24.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
