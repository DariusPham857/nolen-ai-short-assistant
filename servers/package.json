{
  "name": "@nolen/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-Powered Short Film Production Assistant — Backend Server & Worker",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-migrations.mjs && node scripts/copy-fixtures.mjs",
    "start": "node dist/index.js",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "node dist/worker/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src/ --max-warnings 0",
    "test": "vitest run",
    "test:media": "vitest run src/lib/media-validation.media.test.ts src/providers/ffmpeg-pan-zoom.media.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "health:check": "tsx src/scripts/health-check.ts",
    "planner:preflight": "tsx src/scripts/planner-preflight.ts",
    "planner:smoke": "tsx src/scripts/planner-smoke.ts",
    "test:guardrails": "node --test scripts/check-guardrails.test.mjs",
    "test:evidence": "node --test ../scripts/check-evidence.test.mjs",
    "check:evidence": "node ../scripts/check-evidence.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.6",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "zod": "^3.24.4",
    "@nolen/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.24.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.62.0",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": "22.23.0"
  },
  "packageManager": "pnpm@11.21.0",
  "exports": {
    ".": "./dist/app.js",
    "./runtime": "./dist/config/runtime.js"
  }
}
