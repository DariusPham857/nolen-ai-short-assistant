# ──────────────────────────────────────────────────────────
# nolen-ai-short-assistant / servers — environment config
# Copy to .env and fill in secrets. NEVER commit .env files.
# ──────────────────────────────────────────────────────────

# ── Execution Mode ───────────────────────────────────────
# LIVE = real provider API calls, real budget reservations
# REPLAY = pre-recorded local fixtures, zero charges
EXECUTION_MODE=REPLAY

# ── Database (PostgreSQL 16) ─────────────────────────────
DATABASE_URL=postgresql://nolen:nolen_dev@localhost:5432/nolen_film

# ── Server ───────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# ── Storage ──────────────────────────────────────────────
# Local filesystem path for media assets (StorageAdapter)
STORAGE_BASE_PATH=./storage

# ── Provider API Keys (server-side only, never client) ───
# GEMINI_API_KEY=
# RUNWAY_API_KEY=
# FAL_API_KEY=

# ── pg-boss Worker ───────────────────────────────────────
PGBOSS_SCHEMA=pgboss
WORKER_CONCURRENCY=2
