  "constraints": [
    {
      "relname": "films",
      "conname": "films_active_story_same_film",
      "contype": "f",
      "definition": "FOREIGN KEY (id, active_story_revision_id) REFERENCES story_revisions(film_id, id)"
    },
    {
      "relname": "films",
      "conname": "films_brief_bounds",
      "contype": "c",
      "definition": "CHECK (((length(TRIM(BOTH FROM brief)) >= 1) AND (length(TRIM(BOTH FROM brief)) <= 10000)))"
    },
    {
      "relname": "films",
      "conname": "films_budget_nonnegative",
      "contype": "c",
      "definition": "CHECK ((budget_limit_usd_micros >= 0))"
    },
    {
      "relname": "films",
      "conname": "films_duration_bounds",
      "contype": "c",
      "definition": "CHECK (((duration_target_seconds >= 30) AND (duration_target_seconds <= 60)))"
    },
    {
      "relname": "films",
      "conname": "films_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "films",
      "conname": "films_style_bounds",
      "contype": "c",
      "definition": "CHECK (((style_notes IS NULL) OR (length(style_notes) <= 2000)))"
    },
    {
      "relname": "films",
      "conname": "films_title_required",
      "contype": "c",
      "definition": "CHECK ((length(TRIM(BOTH FROM title)) > 0))"
    },
    {
      "relname": "operator_sessions",
