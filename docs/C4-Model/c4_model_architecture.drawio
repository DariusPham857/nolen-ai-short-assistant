<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="page-c4-l1" name="C4 Level 1 - System Context">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px; color: #083F75;&quot;&gt;C4 Level 1 — System Context Diagram&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #555555;&quot;&gt;&lt;b&gt;AI Short Film Production Assistant&lt;/b&gt; — Local-first Profile (Single-User Local Operation / DEC-Q01–DEC-Q04)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="800" height="60" as="geometry" /></mxCell>
        <mxCell id="c1_producer" value="&lt;b&gt;Content Producer / Demo Operator&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Business 1 / IT 1]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Nhập ý tưởng, duyệt kịch bản, duyệt Keyframe,&lt;br/&gt;kiểm soát ngân sách và xuất phim 30–60s" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="180" y="130" width="260" height="170" as="geometry" /></mxCell>
        <mxCell id="c1_reviewer" value="&lt;b&gt;Creative Reviewer / Benchmark Rater&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Designer / Business 2]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Chấm điểm chất lượng hình ảnh, kiểm tra&lt;br/&gt;tính nhất quán &amp;amp; xuất báo cáo đối chứng" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="260" height="170" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;AI Short Film Production Assistant&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Software System - Local-first Profile]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Hệ thống điều phối sản xuất phim ngắn tối ưu chi phí:&lt;br/&gt;Sinh kịch bản, khóa nhất quán, chọn model theo rule,&lt;br/&gt;theo dõi Cost Ledger (append-only) &amp;amp; ghép phim tự động&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;color: #FFEB3B; font-weight: bold;&quot;&gt;👉 Click to drill down into Containers (Level 2)&lt;/font&gt;" link="data:page/id,page-c4-l2" id="c1_system"><mxCell style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#1061B0;strokeColor=#0D5091;fontStyle=0;;cursor=pointer;" vertex="1" parent="1"><mxGeometry x="460" y="360" width="320" height="180" as="geometry" /></mxCell></UserObject>
        <mxCell id="c1_llm_ext" value="&lt;b&gt;LLM Provider API&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Google Gemini / Claude&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Sinh kịch bản phân cảnh (ShotSpec JSON)&lt;br/&gt;và Continuity Sheet" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="240" height="140" as="geometry" /></mxCell>
        <mxCell id="c1_google_ai_ext" value="&lt;b&gt;Google AI Studio API&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System - Primary Flow]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Gemini Omni 1.1 Flash / Imagen&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Tạo ảnh Keyframe &amp;amp; Video chất lượng cao&lt;br/&gt;(Quy đổi token/giây sang USD Rate Card)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="620" width="260" height="140" as="geometry" /></mxCell>
        <mxCell id="c1_fal_ai_ext" value="&lt;b&gt;fal.ai Gateway &amp;amp; 3rd-Party AI APIs&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System - FR-09 Multi-Vendor]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Kling, MiniMax, Flux, Seedance...&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Cung cấp ≥2 model tạo ảnh/video bổ sung" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650" y="620" width="260" height="140" as="geometry" /></mxCell>
        <mxCell id="c1_audio_ext" value="&lt;b&gt;TTS &amp;amp; Licensed Audio Sources&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System / Local Library]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Sinh giọng đọc (Voice-over + Timestamps)&lt;br/&gt;và cung cấp nhạc nền có bản quyền" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="620" width="240" height="140" as="geometry" /></mxCell>
        <mxCell id="c1_rel_1" value="1. Nhập brief, chỉnh sửa Storyboard,&amp;#xa;duyệt Keyframe &amp;amp; xem chi phí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.8;exitY=1.0;exitDx=0;exitDy=0;entryX=0.2;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1_producer" target="c1_system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1_rel_2" value="2. Kiểm duyệt tính nhất quán,&amp;#xa;xuất Cost Report &amp;amp; Manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.2;exitY=1.0;exitDx=0;exitDy=0;entryX=0.8;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1_reviewer" target="c1_system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1_rel_3" value="3. Gửi prompt kịch bản&amp;#xa;(Structured JSON Output)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.15;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1_system" target="c1_llm_ext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1_rel_4" value="4. Gửi request tạo Keyframe/Video&amp;#xa;(Polling/Subscribe)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.38;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1_system" target="c1_google_ai_ext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1_rel_5" value="5. Gửi request theo Router&amp;#xa;(Polling/Subscribe)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.62;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1_system" target="c1_fal_ai_ext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1_rel_6" value="6. Tạo Voice-over&amp;#xa;&amp;amp; tải nhạc nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.85;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1_system" target="c1_audio_ext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1_legend" value="&lt;b&gt;Legend &amp;amp; C4 Conventions&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;font color=&quot;#083F75&quot;&gt;&lt;b&gt;Dark Blue Person:&lt;/b&gt;&lt;/font&gt; User / Operator&lt;br/&gt;• &lt;font color=&quot;#1061B0&quot;&gt;&lt;b&gt;Blue Box:&lt;/b&gt;&lt;/font&gt; Software System (In Scope)&lt;br/&gt;• &lt;font color=&quot;#8C8496&quot;&gt;&lt;b&gt;Grey Box:&lt;/b&gt;&lt;/font&gt; External System (Out of Scope)&lt;br/&gt;• &lt;font color=&quot;#555555&quot;&gt;&lt;b&gt;Dashed Line:&lt;/b&gt;&lt;/font&gt; Boundary&lt;br/&gt;• &lt;font color=&quot;#404040&quot;&gt;&lt;b&gt;Arrow:&lt;/b&gt;&lt;/font&gt; Synchronous / Async Interaction" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#CCCCCC;shadow=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="960" y="25" width="240" height="95" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-c4-l2" name="C4 Level 2 - Container Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px; color: #083F75;&quot;&gt;C4 Level 2 — Container Diagram (Local-first Modular Monolith)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #555555;&quot;&gt;&lt;b&gt;AI Short Film Production Assistant&lt;/b&gt; — Next.js App Router + Async Worker + PostgreSQL 16 + Local Storage + FFmpeg CLI&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="950" height="60" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;⬅ Back to Level 1 (System Context)&lt;/b&gt;" link="data:page/id,page-c4-l1" id="c2_backlink"><mxCell style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;cursor=pointer;" vertex="1" parent="1"><mxGeometry x="1280" y="25" width="270" height="40" as="geometry" /></mxCell></UserObject>
        <mxCell id="c2_user" value="&lt;b&gt;Producer / Demo Operator&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Browser Client]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Thao tác UI Storyboard, duyệt shot,&lt;br/&gt;kích hoạt render &amp;amp; kiểm tra ngân sách" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="220" height="170" as="geometry" /></mxCell>
        <mxCell id="c2_boundary" value="Local Workstation / Docker Environment (IT 1 Production Machine) [System Boundary]" style="swimlane;startSize=35;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;strokeColor=#0D5091;strokeWidth=2;fillColor=#F8FBFD;fontColor=#083F75;fontStyle=1;fontSize=13;align=left;spacingLeft=15;pointerEvents=0;container=1;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="890" height="740" as="geometry" /></mxCell>
        <mxCell id="c2_webapp" value="&lt;b&gt;Next.js Web Application&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: TypeScript / Next.js App Router]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Storyboard UI &amp;amp; Human Approval Gate (F5)&lt;br/&gt;• Script &amp;amp; Continuity Planner via LLM SDK (F1)&lt;br/&gt;• Rule-based Model Router &amp;amp; Explainer (F2)&lt;br/&gt;• Cost Ledger Guardrail &amp;amp; Budget Reservation (F4)&lt;br/&gt;• Media Route Handler (Local file streaming)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontStyle=0;" vertex="1" parent="c2_boundary"><mxGeometry x="40" y="60" width="370" height="230" as="geometry" /></mxCell>
        <mxCell id="c2_worker" value="&lt;b&gt;Async Media &amp;amp; AI Worker&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Node.js Worker Process]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Lắng nghe hàng đợi job từ pg-boss&lt;br/&gt;• Provider Adapter Engine: Polling/Subscribe (F3)&lt;br/&gt;• Tải ngay media về Local Storage (tránh expire)&lt;br/&gt;• Media Assembly Engine gọi FFmpeg CLI (F6)&lt;br/&gt;• Xuất AI Usage Manifest &amp;amp; Cost CSV (F7)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontStyle=0;" vertex="1" parent="c2_boundary"><mxGeometry x="480" y="60" width="370" height="230" as="geometry" /></mxCell>
        <mxCell id="c2_db" value="&lt;b&gt;PostgreSQL 16 Database&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Docker Volume pgdata]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Tables: Film, Scene, Shot, Attempt, Asset&lt;br/&gt;• Cost Ledger (Append-only Financial Events)&lt;br/&gt;• 3 State Machines (Story, Generation, Review)&lt;br/&gt;• Job Queue Tables (pg-boss)" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontStyle=0;" vertex="1" parent="c2_boundary"><mxGeometry x="40" y="440" width="370" height="230" as="geometry" /></mxCell>
        <mxCell id="c2_filestorage" value="&lt;b&gt;Local File System&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Volume: ./data/assets &amp;amp; ./data/exports]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Lưu trữ Keyframe PNG, Video MP4 thô&lt;br/&gt;• Lưu trữ TTS Audio, BGM, Phụ đề ASS/SRT&lt;br/&gt;• Lưu trữ phim thành phẩm &amp;amp; Manifest JSON&lt;br/&gt;• Đóng gói qua StorageAdapter interface" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontStyle=0;" vertex="1" parent="c2_boundary"><mxGeometry x="480" y="440" width="370" height="230" as="geometry" /></mxCell>
        <mxCell id="c2_llm_api" value="&lt;b&gt;LLM API&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System - HTTPS / JSON]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Google Gemini / Claude&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Sinh kịch bản phân cảnh (ShotSpec JSON)&lt;br/&gt;và Continuity Sheet" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="270" height="120" as="geometry" /></mxCell>
        <mxCell id="c2_video_apis" value="&lt;b&gt;AI Media Providers&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System - HTTPS / JSON]&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Google AI Studio (Gemini Omni 1.1 Flash) + fal.ai + Multi-Vendor&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Tạo video MP4, keyframe ảnh &amp;amp; quản lý task async" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1280" y="330" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="c2_ffmpeg_cli" value="&lt;b&gt;FFmpeg CLI Binary&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container / OS Layer - Executable]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Concat clips, chèn logo tĩnh/overlay,&lt;br/&gt;trộn audio (TTS + BGM) &amp;amp; burn phụ đề (ASS/SRT)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1280" y="570" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="c2_rel_1" value="HTTP / localhost:3000&amp;#xa;Tạo kịch bản, duyệt shot, theo dõi chi phí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_user" target="c2_webapp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2_rel_2" value="Drizzle ORM (SQL)&amp;#xa;Đọc/Ghi State, Reserve Budget,&amp;#xa;Enqueue Job vào pg-boss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.35;exitY=1.0;exitDx=0;exitDy=0;entryX=0.35;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_webapp" target="c2_db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2_rel_3" value="StorageAdapter.get()&amp;#xa;Stream ảnh/video lên UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.85;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_webapp" target="c2_filestorage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2_rel_4" value="HTTPS&amp;#xa;Sinh ShotSpec JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.75;exitY=0.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_webapp" target="c2_llm_api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="638" y="115" /><mxPoint x="1240" y="115" /><mxPoint x="1240" y="186" /></Array></mxGeometry></mxCell>
        <mxCell id="c2_rel_5" value="pg-boss Polling (SQL)&amp;#xa;Nhận job &amp;amp; update status,&amp;#xa;Settle/Release Cost Ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.85;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_worker" target="c2_db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2_rel_6" value="StorageAdapter.put()&amp;#xa;Lưu asset ngay khi tải xong" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_worker" target="c2_filestorage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2_rel_7" value="HTTPS (Polling/Subscribe)&amp;#xa;Gọi tạo ảnh/video &amp;amp; kiểm tra quota" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;endSize=8;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2_worker" target="c2_video_apis"><mxGeometry relative="1" as="geometry" /></mxCell>
